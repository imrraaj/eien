{
  "name": "eien",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.8",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p apps/web",
    "check": "bun run typecheck && bun run format:check && bun test",
    "test": "bun test",
    "bot": "bun --no-env-file --env-file=.env packages/gateway/src/index.ts",
    "bot:docker": "SANDBOX_DRIVER=docker bun --no-env-file --env-file=.env --env-file=.env.docker packages/gateway/src/index.ts",
    "bot:sbx": "SANDBOX_DRIVER=sbx bun --no-env-file --env-file=.env --env-file=.env.sbx packages/gateway/src/index.ts",
    "deploy": "./deploy/setup.sh",
    "undeploy": "./deploy/down.sh",
    "bot:dev": "bun --no-env-file --env-file=.env --watch packages/gateway/src/index.ts",
    "bot:docker:dev": "SANDBOX_DRIVER=docker bun --no-env-file --env-file=.env --env-file=.env.docker --watch packages/gateway/src/index.ts",
    "bot:sbx:dev": "SANDBOX_DRIVER=sbx bun --no-env-file --env-file=.env --env-file=.env.sbx --watch packages/gateway/src/index.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "web:dev": "vite apps/web",
    "web:build": "tsc --noEmit -p apps/web && vite build apps/web"
  },
  "dependencies": {
    "@earendil-works/chord": "^1.5.2",
    "@earendil-works/pi-ai": "^1.5.2",
    "@earendil-works/pi-durable": "^1.5.2",
    "@earendil-works/pi-schema": "^1.5.2",
    "@fontsource/instrument-serif": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/schibsted-grotesk": "^5.3.0",
    "better-result": "^3.0.1",
    "grammy": "^1.46.0",
    "highlight.js": "^11.12.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "prettier": "^3.10.1",
    "typescript": "^5.9.0",
    "vite": "^8.3.8"
  }
}
