{
  "name": "eien",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.8",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "check": "bun run typecheck && bun test",
    "test": "bun test",
    "bot": "bun packages/gateway/src/index.ts",
    "deploy": "./deploy/setup.sh",
    "undeploy": "./deploy/down.sh",
    "bot:dev": "bun --watch packages/gateway/src/index.ts",
    "up": "docker compose up -d",
    "down": "docker compose down",
    "ps": "docker compose ps",
    "logs": "docker compose logs -f --tail=100",
    "temporal:cli": "docker compose exec temporal-admin-tools temporal"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "typescript": "^5.9.0"
  },
  "dependencies": {
    "@earendil-works/chord": "^1.5.2",
    "@earendil-works/pi-durable": "^1.5.2",
    "@earendil-works/pi-schema": "^1.5.2"
  }
}
