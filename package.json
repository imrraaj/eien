{
  "name": "eien",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.8",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "check": "bun run typecheck && bun test",
    "test": "bun test",
    "bot": "bun packages/gateway/src/index.ts",
    "deploy": "./deploy/setup.sh",
    "undeploy": "./deploy/down.sh",
    "bot:dev": "bun --watch packages/gateway/src/index.ts"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "better-result": "^3.0.1",
    "typescript": "^5.9.0"
  }
}
