# Copy to .env and fill in. Never commit .env.
# Shared by both sandboxes. Backend settings live in .env.docker / .env.sbx
# (see .env.docker.example and .env.sbx.example).

# ── LLM: any OpenAI-compatible endpoint (OpenRouter is the default)
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_MS=120000
LLM_CONTEXT_WINDOW=128000
LLM_MAX_TOKENS=8192

# The model the agent runs on (OpenRouter ID, or whatever the endpoint expects).
MODEL_MAIN=

# Optional: replace the bundled persona, or the whole system prompt.
SOUL_PATH=
SYSTEM_PROMPT=

# Legacy OpenRouter names; read as fallbacks when LLM_* is unset.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ── Telegram
TELEGRAM_BOT_TOKEN=
# Comma-separated numeric user IDs allowed to talk to the bot, e.g. 123456789
ALLOWED_TELEGRAM_USER_IDS=

# ── Sandbox
# Backend-specific settings live in .env.docker or .env.sbx. Run the bot with
# `bun run bot:docker` or `bun run bot:sbx` to load the right one.
MAX_AGENT_STEPS=100

# ── Web search (Exa hosted MCP). Keyless by default; a key raises limits.
EXA_MCP_URL=https://mcp.exa.ai/mcp
EXA_API_KEY=

# ── State and logging
STATE_DIR=state
LOG_LEVEL=info
