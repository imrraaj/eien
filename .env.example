# Copy to .env and fill in. Never commit .env.

# ── Docker Compose (optional overrides; defaults match docker-compose.yml)
# POSTGRESQL_VERSION=16
# TEMPORAL_VERSION=1.29.1
# TEMPORAL_ADMINTOOLS_VERSION=1.29.1-tctl-1.18.4-cli-1.5.0
# TEMPORAL_UI_VERSION=2.34.0
# POSTGRES_USER=temporal
# POSTGRES_PASSWORD=temporal
# AGENT_DB_NAME=agent
# AGENT_DB_USER=agent
# AGENT_DB_PASSWORD=agent

# ── Temporal
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=brain

# ── App DB
DATABASE_URL=postgres://agent:agent@localhost:5432/agent

# ── OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
MODEL_MAIN=
MODEL_WORKER=
MODEL_CHEAP=

# ── Telegram
TELEGRAM_BOT_TOKEN=
ALLOWED_TELEGRAM_USER_IDS=

# ── Sandbox
SBX_NAME=agent-1
MAX_CONCURRENT_WORKERS=3

# ── Google CLI (host-side only)
GOOGLE_CLI_BIN=
GOOGLE_CLI_CONFIG_DIR=

# ── Logging
LOG_LEVEL=info
